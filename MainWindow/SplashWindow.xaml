<Window x:Class="MainWindowProgram.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка | АСК-МКИ-М"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- локальные краски -->
        <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FF23262B"/>
        <SolidColorBrush x:Key="TitleAccentBrush"      Color="#FF00AEEF"/>
        <SolidColorBrush x:Key="SubtleTextBrush"       Color="#B0B3BA"/>
        <SolidColorBrush x:Key="RingBaseBrush"         Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="RingActiveBrush"       Color="#FFFFFFFF"/>

        <!-- анимация вращения -->
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerArc"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                       To="360" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="24" Background="{StaticResource SplashBackgroundBrush}" Padding="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- логотип -->
            <Image Width="120" Height="120" Margin="0,0,0,20"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Image.Source>
                    <BitmapImage UriSource="pack://application:,,,/MainWindowProgram;component/Resources/logo.png"
                       CacheOption="OnLoad" CreateOptions="IgnoreImageCache"/>
                </Image.Source>
            </Image>

            <!-- заголовок -->
            <TextBlock Text="АСК-МКИ-М" FontSize="28" FontWeight="Bold"
                 Foreground="{StaticResource TitleAccentBrush}"
                 TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- организация -->
            <TextBlock Text="АО «Ижевский мотозавод «Аксион-холдинг»"
                 FontSize="16" Foreground="{StaticResource SubtleTextBrush}"
                 Margin="0,8,0,0" TextAlignment="Center"/>

            <!-- индикатор -->
            <Grid Width="40" Height="40" Margin="0,30,0,0">
                <Ellipse Width="40" Height="40" StrokeThickness="4"
                 Stroke="{StaticResource RingBaseBrush}"/>
                <Ellipse x:Name="SpinnerArc" Width="40" Height="40"
                 StrokeThickness="4" Stroke="{StaticResource RingActiveBrush}"
                 StrokeDashArray="4 6">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" CenterX="20" CenterY="20"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

        </StackPanel>
    </Border>
</Window>