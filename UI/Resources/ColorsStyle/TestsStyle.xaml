<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="tests.input.background.header.panel">#A4EB9E</Color>
    <Color x:Key="tests.input.background.input.panel">#FFFFFF</Color>
    <Color x:Key="tests.main.panel.background">#DDDDDD</Color>
    <Color x:Key="tests.main.button.background">#FFFFFF</Color>
    
    <SolidColorBrush x:Key="TestsInputBackgroundHeaderPanelBrush" Color="{DynamicResource tests.input.background.header.panel}"/>
    <SolidColorBrush x:Key="TestsInputBackgroundInputPanelBrush" Color="{DynamicResource tests.input.background.input.panel}"/>
    <SolidColorBrush x:Key="TestsMainPanelBackgroundBrush" Color="{DynamicResource tests.main.panel.background}"/>
    <SolidColorBrush x:Key="TestsMainButtonBackgroundBrush" Color="{DynamicResource tests.main.button.background}"/>

    <Color x:Key="tests.input.text.header.color">#000000</Color>
    <Color x:Key="tests.input.text.description.color">#A9B5C3</Color>

    <SolidColorBrush x:Key="TestsInputHeaderSolidColorBrush" Color="{DynamicResource tests.input.text.header.color}"/>
    <SolidColorBrush x:Key="TestsInputDescriptionSolidColorBrush" Color="{DynamicResource tests.input.text.description.color}"/>

    <Color x:Key="tests.main.button.orange.start">#90F47842</Color>
    <Color x:Key="tests.main.button.orange.end">#90FCAA3F</Color>

    <Color x:Key="tests.main.button.green.start">#90459C3C</Color>
    <Color x:Key="tests.main.button.green.end">#9067C66E</Color>

    <Color x:Key="tests.main.background.interactive">#FFFFFF</Color>
    <Color x:Key="tests.main.border.interactive">#000000</Color>
    <Color x:Key="tests.main.active.interactive">#A4EB9E</Color>
    <Color x:Key="tests.main.pressed.interactive">#79E171</Color>

    <SolidColorBrush x:Key="TestsInteractiveBackgroundSolidColorBrush" Color="{DynamicResource tests.main.background.interactive}"/>
    <SolidColorBrush x:Key="TestsInteractiveBorderSolidColorBrush" Color="{DynamicResource tests.main.border.interactive}"/>
    <SolidColorBrush x:Key="TestsInteractiveActiveSolidColorBrush" Color="{DynamicResource tests.main.active.interactive}"/>
    <SolidColorBrush x:Key="TestsInteractivePressedSolidColorBrush" Color="{DynamicResource tests.main.pressed.interactive}"/>

</ResourceDictionary>