<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Текст -->
    <SolidColorBrush x:Key="SettingsTitleSolidColorBrush" Color="{DynamicResource settings.text.title.color}"/>
    <SolidColorBrush x:Key="SettingsHeaderSolidColorBrush" Color="{DynamicResource settings.text.header.color}"/>
    <SolidColorBrush x:Key="SettingsDescriptionSolidColorBrush" Color="{DynamicResource settings.text.description.color}"/>

    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTitleSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonMedium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="SettingsHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsHeaderSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonMedium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsDescriptionSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonLight}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--#endregion-->

    <!--#region Весь элемент управления настройками -->
    <SolidColorBrush x:Key="SettingsMainBackgroundSolidColorBrush" Color="{DynamicResource settings.background.main}"/>
    
    <!--#endregion-->

    <!--#region Общая панель с настройками -->
    <SolidColorBrush x:Key="SettingsPanelBackgroundSolidColorBrush" Color="{DynamicResource settings.background.panel}"/>
    <SolidColorBrush x:Key="SettingsPanelBorderSolidColorBrush" Color="{DynamicResource settings.border.panel}"/>

    <Style x:Key="SettingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsPanelBackgroundSolidColorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsPanelBorderSolidColorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <!--#endregion-->

    <!--#region Карточка с настройкой -->

    <SolidColorBrush x:Key="SettingsCardBackgroundSolidColorBrush" Color="{DynamicResource settings.background.card}"/>
    <SolidColorBrush x:Key="SettingsCardBorderSolidColorBrush" Color="{DynamicResource settings.border.card}"/>

    <Style x:Key="SettingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundSolidColorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderSolidColorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <!--#endregion-->

    <!--#region Чек бокс и кнопки -->
    <SolidColorBrush x:Key="SettingsInteractiveBackgroundSolidColorBrush" Color="{DynamicResource settings.background.interactive}"/>
    <SolidColorBrush x:Key="SettingsInteractiveBorderSolidColorBrush" Color="{DynamicResource settings.border.interactive}"/>
    <SolidColorBrush x:Key="SettingsInteractiveHoverSolidColorBrush" Color="{DynamicResource settings.hover.interactive.background}"/>
    <SolidColorBrush x:Key="SettingsInteractiveActiveSolidColorBrush" Color="{DynamicResource settings.active.interactive}"/>
    <SolidColorBrush x:Key="SettingsInteractivePressedSolidColorBrush" Color="{DynamicResource settings.pressed.interactive}"/>
    <!--#endregion-->

    <!--#region Панель выбора -->

    <SolidColorBrush x:Key="SettingsSliderBackgroundSolidColorBrush" Color="{DynamicResource settings.background.slider}"/>
    <SolidColorBrush x:Key="SettingsSelectorBackgroundSolidColorBrush" Color="{DynamicResource settings.background.selector}"/>
    <SolidColorBrush x:Key="SettingsSelectorHoverSolidColorBrush" Color="{DynamicResource settings.hover.selector.background}"/>
    <SolidColorBrush x:Key="SettingsSelectorSelectedSolidColorBrush" Color="{DynamicResource settings.selected.selector}"/>
    <SolidColorBrush x:Key="SettingsSliderBorderSolidColorBrush" Color="{DynamicResource settings.border.slider}"/>

    <!--#endregion-->

    <!--#region Конфигурация -->
    <SolidColorBrush x:Key="SettingsCongifButtonBackgroundSolidColorBrush" Color="{DynamicResource settings.background.config.button}"/>
    <SolidColorBrush x:Key="SettingsCongifButtonHoverBackgroundSolidColorBrush" Color="{DynamicResource settings.hover.config.button.background}"/>
    <SolidColorBrush x:Key="SettingsCongifButtonBorderSolidColorBrush" Color="{DynamicResource settings.border.config.button}"/>
    <SolidColorBrush x:Key="SettingsInfoTabloBackgroundSolidColorBrush" Color="{DynamicResource settings.background.config.infoTablo}"/>
    <SolidColorBrush x:Key="SettingsConfigDataInputTabloBackgroundSolidColorBrush" Color="{DynamicResource settings.background.config.dataInputTablo}"/>

    <!--#endregion-->

</ResourceDictionary>