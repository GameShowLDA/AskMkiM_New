<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Текст -->
    
    <Color x:Key="SettingsTitleColor">#000000</Color>
    <Color x:Key="SettingsHeaderColor">#000000</Color>
    <Color x:Key="SettingsDescriptionColor">#414149</Color>

    <SolidColorBrush x:Key="SettingsTitleSolidColorBrush" Color="{DynamicResource SettingsTitleColor}"/>
    <SolidColorBrush x:Key="SettingsHeaderSolidColorBrush" Color="{DynamicResource SettingsHeaderColor}"/>
    <SolidColorBrush x:Key="SettingsDescriptionSolidColorBrush" Color="{DynamicResource SettingsDescriptionColor}"/>

    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTitleSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonMedium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="SettingsHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsHeaderSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonMedium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SettingsDescriptionSolidColorBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WinstonLight}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--#endregion-->

    <!--#region Весь элемент управления настройками -->

    <Color x:Key="SettingsMainBackground">#DDDDDD</Color>
    <SolidColorBrush x:Key="SettingsMainBackgroundSolidColorBrush" Color="{DynamicResource SettingsMainBackground}"/>
    
    <!--#endregion-->

    <!--#region Общая панель с настройками -->

    <Color x:Key="SettingsPanelBackground">#EBEBEB</Color>
    <Color x:Key="SettingsPanelBorder">#EBEBEB</Color>

    <SolidColorBrush x:Key="SettingsPanelBackgroundSolidColorBrush" Color="{DynamicResource SettingsPanelBackground}"/>
    <SolidColorBrush x:Key="SettingsPanelBorderSolidColorBrush" Color="{DynamicResource SettingsPanelBorder}"/>

    <Style x:Key="SettingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsPanelBackgroundSolidColorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsPanelBorderSolidColorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <!--#endregion-->

    <!--#region Карточка с настройкой -->

    <Color x:Key="SettingsCardBackground">#FFFFFF</Color>
    <Color x:Key="SettingsCardBorder">#000000</Color>

    <SolidColorBrush x:Key="SettingsCardBackgroundSolidColorBrush" Color="{DynamicResource SettingsCardBackground}"/>
    <SolidColorBrush x:Key="SettingsCardBorderSolidColorBrush" Color="{DynamicResource SettingsCardBorder}"/>

    <Style x:Key="SettingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundSolidColorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderSolidColorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <!--#endregion-->

    <!--#region Чек бокс и кнопки -->
    <Color x:Key="SettingsInteractiveBackground">#FFFFFF</Color>
    <Color x:Key="SettingsInteractiveHover">#A4EB9E</Color>
    <Color x:Key="SettingsInteractiveBorder">#000000</Color>
    <Color x:Key="SettingsInteractiveActive">#A4EB9E</Color>
    <Color x:Key="SettingsInteractivePressed">#79E171</Color>

    <SolidColorBrush x:Key="SettingsInteractiveBackgroundSolidColorBrush" Color="{DynamicResource SettingsInteractiveBackground}"/>
    <SolidColorBrush x:Key="SettingsInteractiveBorderSolidColorBrush" Color="{DynamicResource SettingsInteractiveBorder}"/>
    <SolidColorBrush x:Key="SettingsInteractiveHoverSolidColorBrush" Color="{DynamicResource SettingsInteractiveHover}"/>
    <SolidColorBrush x:Key="SettingsInteractiveActiveSolidColorBrush" Color="{DynamicResource SettingsInteractiveActive}"/>
    <SolidColorBrush x:Key="SettingsInteractivePressedSolidColorBrush" Color="{DynamicResource SettingsInteractivePressed}"/>
    <!--#endregion-->

    <!--#region Панель выбора -->
    <Color x:Key="SettingsSliderBackground">#FFFFFF</Color>
    <Color x:Key="SettingsSelectorBackground">#FFFFFF</Color>
    <Color x:Key="SettingsSelectorHover">#A4EB9E</Color>
    <Color x:Key="SettingsSelectorSelected">#79E171</Color>
    <Color x:Key="SettingsSliderBorder">#000000</Color>

    <SolidColorBrush x:Key="SettingsSliderBackgroundSolidColorBrush" Color="{DynamicResource SettingsSliderBackground}"/>
    <SolidColorBrush x:Key="SettingsSelectorBackgroundSolidColorBrush" Color="{DynamicResource SettingsSelectorBackground}"/>
    <SolidColorBrush x:Key="SettingsSelectorHoverSolidColorBrush" Color="{DynamicResource SettingsSelectorHover}"/>
    <SolidColorBrush x:Key="SettingsSelectorSelectedSolidColorBrush" Color="{DynamicResource SettingsSelectorSelected}"/>
    <SolidColorBrush x:Key="SettingsSliderBorderSolidColorBrush" Color="{DynamicResource SettingsSliderBorder}"/>

    <!--#endregion-->

    <!--#region Конфигурация -->
    <Color x:Key="SettingsCongifButtonBackground">#80465945</Color>
    <Color x:Key="SettingsCongifButtonHoverBackground">#90465945</Color>
    <Color x:Key="SettingsConfigButtonBorder">#000000</Color>
    <Color x:Key="SettingsConfigInfoTabloBackground">#90465945</Color>
    <Color x:Key="SettingsConfigDataInputTabloBackground">#FFFFFF</Color>

    <SolidColorBrush x:Key="SettingsCongifButtonBackgroundSolidColorBrush" Color="{DynamicResource SettingsCongifButtonBackground}"/>
    <SolidColorBrush x:Key="SettingsCongifButtonHoverBackgroundSolidColorBrush" Color="{DynamicResource SettingsCongifButtonHoverBackground}"/>
    <SolidColorBrush x:Key="SettingsCongifButtonBorderSolidColorBrush" Color="{DynamicResource SettingsConfigButtonBorder}"/>
    <SolidColorBrush x:Key="SettingsInfoTabloBackgroundSolidColorBrush" Color="{DynamicResource SettingsConfigInfoTabloBackground}"/>
    <SolidColorBrush x:Key="SettingsConfigDataInputTabloBackgroundSolidColorBrush" Color="{DynamicResource SettingsConfigDataInputTabloBackground}"/>

    <!--#endregion-->

</ResourceDictionary>