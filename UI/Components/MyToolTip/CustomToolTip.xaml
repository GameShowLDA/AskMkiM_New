<UserControl x:Class="UI.Components.CustomToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Components"
             mc:Ignorable="d" 
             x:Name="Root">
    <UserControl.Resources>
        
        <DropShadowEffect x:Key="DropShadow"
                  Color="Black"
                  Direction="270"
                  ShadowDepth="4"
                  BlurRadius="12"
                  Opacity="0.5"/>
    </UserControl.Resources>

    <Border Background="#2B2B2B"
          Padding="12"
          CornerRadius="8"
          BorderBrush="#444"
          BorderThickness="1"
          Effect="{DynamicResource DropShadow}">

        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                 Foreground="White"
                 FontWeight="Bold"
                 FontSize="14"
                 Margin="0 0 0 4"/>

            <TextBlock Text="{Binding Description, ElementName=Root}"
                 Foreground="#DDDDDD"
                 TextWrapping="Wrap"
                 MaxWidth="280"/>
        </StackPanel>

    </Border>
</UserControl>
