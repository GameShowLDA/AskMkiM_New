<UserControl x:Class="UI.Components.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="84" d:DesignWidth="320" MaxWidth="300">
    <UserControl.Resources>
        <!-- Палитра по твоему UI -->
        <SolidColorBrush x:Key="CardBorder"     Color="{DynamicResource SecondaryColor}"/>
        <SolidColorBrush x:Key="DescBrush"      Color="{DynamicResource ForegroundColor60}"/>
        <SolidColorBrush x:Key="CheckBg"        Color="{DynamicResource PrimaryColor}"/>
        <SolidColorBrush x:Key="CheckBorder"    Color="{DynamicResource IsCheckedColor}"/>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">

                            <!-- база -->
                            <Border x:Name="Box"
                                Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                BorderBrush="#415163"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                RenderOptions.EdgeMode="Aliased"/>

                            <Border x:Name="Inset"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="#20FFFFFF"
                                IsHitTestVisible="False"/>


                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                            </Trigger>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveHoverSolidColorBrush}"/>
                            </Trigger>

                            <!-- Pressed (слегка темнее) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SettingsInteractivePressedSolidColorBrush}"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Карточка -->
    <Border 
        Style="{DynamicResource SettingCardStyle}"
          Padding="10"
          SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Чекбокс слева: привязываем к DP IsChecked -->
            <CheckBox Grid.Column="0"
                Style="{StaticResource SettingsCheckBox}"
                IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      Cursor="Hand"
                      />

            <!-- Текстовый блок справа -->
            <Grid Grid.Column="2" x:Name="TextHost" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,0,0,2"
                             Style="{DynamicResource SettingsHeaderStyle}" />

                <TextBlock Grid.Row="1"
             Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Style="{DynamicResource SettingsDescriptionStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
