<Window x:Class="UI.Components.Archive.NewArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание архива" Height="220" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Путь -->
        <TextBlock Grid.Row="0" Text="Папка:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" x:Name="PathBox" IsReadOnly="True"/>
        <Button Grid.Row="0" Grid.Column="2" Content="..." Width="30" Click="Browse_Click"/>

        <!-- Название -->
        <TextBlock Grid.Row="1" Text="Название:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Grid.ColumnSpan="2" x:Name="NameBox"/>

        <!-- Описание -->
        <TextBlock Grid.Row="2" Text="Описание:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Grid.ColumnSpan="2" x:Name="DescBox"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Width="80" Margin="5,0" Content="ОК" IsDefault="True" Click="Ok_Click"/>
            <Button Width="80" Margin="5,0" Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
