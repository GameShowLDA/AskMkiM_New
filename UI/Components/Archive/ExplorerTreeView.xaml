<UserControl x:Class="UI.Components.Archive.ExplorerTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Components.Archive"
             xmlns:models="clr-namespace:UI.Controls.Archive.Models"
             xmlns:ArchiveMenu="clr-namespace:UI.Components.Archive.ArchiveMenu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <TreeView x:Name="PART_Tree"
              Background="{DynamicResource SecondarySolidColorBrush}"
              BorderThickness="0,0,1,0"
              Foreground="{DynamicResource ForegroundSolidColorBrush}"
              Padding="5"
              ItemsSource="{Binding Path=ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">

        <TreeView.Resources>

            <!-- ===== Контейнер TreeViewItem ===== -->
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundSolidColorBrush}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontFamily" Value="{DynamicResource WinstonMedium}"/>
                <Setter Property="Margin" Value="0,6,0,6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- стрелка -->
                                <ToggleButton x:Name="Expander"
                                              Grid.Row="0" Grid.Column="0"
                                              Width="16" Height="16"
                                              Margin="0,0,2,0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path x:Name="Arrow"
                                                      Width="10" Height="10"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Data="M 0 0 L 0 6 L 6 3 Z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- заголовок -->
                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Row="0" Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,0,0"/>

                                <!-- дети -->
                                <ItemsPresenter x:Name="ItemsHost"
                                                Grid.Row="1" Grid.Column="1"
                                                Margin="24,6,0,0"
                                                Visibility="Collapsed"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Контекстные меню ===== -->

            <!-- Меню пустой области -->
            <ContextMenu x:Key="EmptyContextMenu" Style="{StaticResource AppContextMenuStyle}">
                <MenuItem Header="Создать корневую папку…" Click="OnCreateRootClick"/>
            </ContextMenu>
            

            <!-- Папка -->
            <ContextMenu x:Key="FolderContextMenu" Style="{StaticResource AppContextMenuStyle}">
                <MenuItem Header="Открыть" Click="OnOpenFolderClick"/>
                <MenuItem Header="Показать в папке" Click="OnRevealFolderClick"/>
                <Separator Style="{StaticResource AppSeparatorStyle}"/>
                <MenuItem Header="Создать архив…" Click="OnCreateArchiveClick"/>
                <MenuItem Header="Удалить корень" Click="OnDeleteRootClick"/>
            </ContextMenu>

            <!-- OPK -->
            <ContextMenu x:Key="OpkContextMenu" Style="{StaticResource AppContextMenuStyle}">
                <MenuItem Header="Показать архив в папке" Click="OnRevealArchiveFromOpkClick"/>
                <Separator Style="{StaticResource AppSeparatorStyle}"/>
                <MenuItem Header="Удалить файл из архива" Click="OnDeleteOpkClick"/>
            </ContextMenu>

            <!-- ===== DataTemplates ===== -->

            <!-- Папки -->
            <HierarchicalDataTemplate DataType="{x:Type models:ArchiveFolder}" ItemsSource="{Binding Archives}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                            <!-- если это системная папка и IsAdmin=false, скрываем меню -->
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSystem}" Value="True"/>
                                        <Condition Binding="{Binding IsAdmin, RelativeSource={RelativeSource AncestorType=local:ExplorerTreeView}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="📁 "/><Run Text="{Binding FolderName}"/>
                </TextBlock>
            </HierarchicalDataTemplate>

            <!--Архивы-->
            <HierarchicalDataTemplate DataType="{x:Type models:ArchiveModel}" ItemsSource="{Binding OpkFiles}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="ContextMenu" Value="{StaticResource ArchiveContextMenu}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <!-- если архив системный -->
                                        <Condition Binding="{Binding IsSystem}" Value="True"/>
                                        <!-- и нет прав админа -->
                                        <Condition Binding="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerTreeView}}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
        <Run Text="📦 "/><Run Text="{Binding ArchiveName}"/>
                </TextBlock>
            </HierarchicalDataTemplate>






            <!-- OPK-файлы -->
            <DataTemplate DataType="{x:Type models:OpkModel}">
                <TextBlock ContextMenu="{StaticResource OpkContextMenu}">
                    <Run Text="📄 "/><Run Text="{Binding OpkFilename}"/>
                </TextBlock>
            </DataTemplate>

        </TreeView.Resources>

        <!-- Меню по пустой области -->
        <TreeView.ContextMenu>
            <StaticResource ResourceKey="EmptyContextMenu"/>
        </TreeView.ContextMenu>
    </TreeView>
</UserControl>
