<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UI.Components.Archive.ArchiveMenu.ArchiveContextMenu">

    <ContextMenu x:Key="ArchiveContextMenu" Style="{StaticResource AppContextMenuStyle}">
        <MenuItem Header="Открыть архив" Click="OnOpenArchiveClick"/>
        <MenuItem Header="Показать в папке" Click="OnRevealArchiveClick"/>
        <Separator Style="{StaticResource AppSeparatorStyle}"/>
        <MenuItem Header="Удалить архив" Click="OnDeleteArchiveClick"/>
    </ContextMenu>
    
</ResourceDictionary>
