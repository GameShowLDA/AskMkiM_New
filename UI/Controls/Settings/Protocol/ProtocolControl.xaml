<UserControl x:Class="UI.Controls.Settings.Protocol.ProtocolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Controls.Settings.Protocol"
             xmlns:Components ="clr-namespace:UI.Components"
             xmlns:Icons="clr-namespace:UI.Icon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Background="{StaticResource IsCheckedColorSolidColorBrush80}" Margin="15,10" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource ForegroundSolidColorBrush60}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Text="Протокол"
                    FontSize="18"
                    Padding="10,10"
                    Foreground="{DynamicResource ForegroundSolidColorBrush}"
                    FontFamily="{DynamicResource WinstonMedium}"
                    VerticalAlignment="Center"/>

                <Grid Grid.Column="1"  Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Icons:SuccessIconControlV2 
                        Grid.Column="1"
                        x:Name="Success" 
                        Width="30"
                        Margin="10,0,0,0"
                        Height="30" 
                        CheckThickness="4"
                        CircleBackground ="{DynamicResource IsCheckedColorSolidColorBrush}"
                        CircleBorder="{DynamicResource PrimarySolidColorBrush}"
                        />

                    <Icons:ErrorIconControlV2 
                      x:Name="Error"
                        Grid.Column="2"
                      Width="30"
                      Height="30" 
                        Margin="10,0,0,0"
                        CrossThickness="4"
                      CircleBackground ="{DynamicResource IsCheckedColorSolidColorBrush}"
                      CircleBorder="{DynamicResource PrimarySolidColorBrush}"
                      />


                    <Icons:ArrowButton x:Name="ToggleSettingsButton" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Right"
                                           Width="30" Height="30"
                                           ButtonBackground="{DynamicResource PrimarySolidColorBrush}"
                                           ButtonBorder="{DynamicResource PrimarySolidColorBrush}"
                                           ArrowBrush="{DynamicResource ForegroundSolidColorBrush}"
                                           ArrowHoverBrush="{DynamicResource ActiveForegroundSolidColorBrush80}"
                                           VerticalAlignment="Center"/>
                </Grid>

            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <WrapPanel Orientation="Horizontal" >
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ToggleSettingsButton, Path=IsArrowUp}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>

                    <!-- Карточки настроек -->
                    <Components:SettingsCard
                        Title="Отображение оборудования"
                        Description="Отображение информации выполняемых устройствами операций. В режиме отключения выводятся лишь измеренные значения. Ошибки показываются независимо от настройки."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        Margin="10,10"
                        VerticalAlignment="Top"
                        x:Name="DeviceInfo"
                        />

                    <Components:SettingsCard
                        Title="Вывод времени операции"
                        Description="Показывает, сколько времени прошло с момента запуска на каждом шаге выполнения."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        Margin="10,10"
                        x:Name="OperationTime"
                        VerticalAlignment="Top"/>

                    <Components:SettingsCard
                        Title="Сохранение протокола"
                        Description="Автоматически сохраняет протокол каждого запуска. Имя файла содержит дату, время и название выполняемых действий."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        Margin="10,10"
                        x:Name="AutoSave"
                        VerticalAlignment="Top"/>

                    <Components:SettingsCard
                        Title="Печать протокола"
                        Description="По завершении выполнения отображает диалог выбора принтера для печати итогового протокола."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        x:Name="AutoPrint"
                        Margin="10,10"
                        VerticalAlignment="Top"/>

                    <Components:SettingsCard
                        Title="Вывод протокола в ПО"
                        Description="По завершении выполнения протокол отображается в программном обеспечении, по умолчанию открывается как PDF-файл."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        x:Name="ProtocolFromPO"
                        Margin="10,10"
                        VerticalAlignment="Top"/>

                    <Components:SettingsCard
                        Title="Формирование протокола"
                        Description="Протокол будет формироваться после выполнения программ контроля."
                        IsChecked="{Binding IdleMode, Mode=TwoWay}"
                        Margin="10,10"
                        VerticalAlignment="Top"
                        x:Name="ProtocolGeneration"/>
                </WrapPanel>

                <Border Grid.Row="1" Background="{DynamicResource IsCheckedColorSolidColorBrush80}" Margin="15,10" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource ForegroundSolidColorBrush60}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">



                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock 
                                    Text="Текст протокола без ошибок" 
                                    FontSize="18" 
                                    Padding="10,10"
                                    Foreground="{DynamicResource ForegroundSolidColorBrush}"
                                    FontFamily="{DynamicResource WinstonMedium}"
                                    VerticalAlignment="Center"  
                                    Grid.Row="0"/>

                            <Grid Grid.Column="1"  Margin="20,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Icons:ArrowButton x:Name="ToggleSettingsTextProtocolButton" 
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Right"
                                                    Width="30" Height="30"
                                                    ButtonBackground="{DynamicResource PrimarySolidColorBrush}"
                                                    ButtonBorder="{DynamicResource PrimarySolidColorBrush}"
                                                    ArrowBrush="{DynamicResource ForegroundSolidColorBrush}"
                                                    ArrowHoverBrush="{DynamicResource ActiveForegroundSolidColorBrush80}"
                                                    VerticalAlignment="Center"/>

                                <Icons:RepeatIcon x:Name="RestartClearProtocol" Grid.Column="1" Margin="10,0" Size="20" PreviewMouseDown="RepeatIcon_PreviewMouseDown"/>
                            </Grid>
                        </Grid>

                        <local:ProtocolTemplateEditorControl Grid.Row="1" Margin="10" x:Name="BaseTextProtocol">
                            <local:ProtocolTemplateEditorControl.Style>
                                <Style TargetType="local:ProtocolTemplateEditorControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ToggleSettingsButton, Path=IsArrowUp}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=ToggleSettingsTextProtocolButton, Path=IsArrowUp}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </local:ProtocolTemplateEditorControl.Style>
                        </local:ProtocolTemplateEditorControl>
                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </Border>
</UserControl>
