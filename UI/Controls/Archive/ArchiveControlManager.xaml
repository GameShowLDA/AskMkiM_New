<UserControl x:Class="UI.Controls.Archive.ArchiveControlManager"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Controls.Archive"
             xmlns:CustomControls="clr-namespace:UI.Components"
             xmlns:models="clr-namespace:UI.Controls.Archive.Models"
             xmlns:TreeViewArchive ="clr-namespace:UI.Components.Archive"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="{StaticResource CategoryPanelBackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CustomControls:MenuButton x:Name="MenuButton"
                                           Margin="3"
                                           Grid.Column="1"
                                           Style="{StaticResource MenuButtonActive}"/>

                <Border Background="{StaticResource CategoryPanelBackgroundColor}" Grid.Column="2">
                    <TextBlock Style="{StaticResource MetrologyTextBlockStyle}"
                               Foreground="{StaticResource ActiveBorderSolidColorBrush}"
                               Margin="10,0"
                               Text="Проводник"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>
            </Grid>

            <TreeViewArchive:ExplorerTreeView 
                x:Name="Explorer"
                Grid.Row="1"/>

        </Grid>
    </Grid>
</UserControl>
